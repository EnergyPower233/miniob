{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MiniOB: CLI (LLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build_debug/bin/observer",
      "args": [
        "-f",
        "${workspaceFolder}/etc/observer.ini",
        "-P",
        "cli"
      ],
      "cwd": "${workspaceFolder}/build_debug",
      "terminal": "integrated",
      "stopOnEntry": false,
      "preLaunchTask": "build_debug"
    },
    {
      "name": "MiniOB: Server (LLDB, port 6789)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build_debug/bin/observer",
      "args": [
        "-f",
        "${workspaceFolder}/etc/observer.ini",
        "-p",
        "6789"
      ],
      "cwd": "${workspaceFolder}/build_debug",
      "terminal": "integrated",
      "stopOnEntry": false,
      "preLaunchTask": "build_debug"
    }
  ]
}
