{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MiniOB: CLI (LLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/out/Linux-clang-debug/bin/observer",
      "args": [
        "-f",
        "${workspaceFolder}/etc/observer.ini",
        "-P",
        "cli"
      ],
      "cwd": "${workspaceFolder}/out/Linux-clang-debug",
      "terminal": "integrated",
      "stopOnEntry": false,
      "preLaunchTask": "build_debug",
      "osx": {
        "program": "${workspaceFolder}/out/Darwin-clang-debug/bin/observer",
        "cwd": "${workspaceFolder}/out/Darwin-clang-debug"
      },
      "linux": {
        "program": "${workspaceFolder}/out/Linux-clang-debug/bin/observer",
        "cwd": "${workspaceFolder}/out/Linux-clang-debug"
      },
      "windows": {
        "program": "${workspaceFolder}/out/Windows-clang-debug/bin/observer.exe",
        "cwd": "${workspaceFolder}/out/Windows-clang-debug"
      }
    },
    {
      "name": "MiniOB: Server (LLDB, port 6789)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/out/Linux-clang-debug/bin/observer",
      "args": [
        "-f",
        "${workspaceFolder}/etc/observer.ini",
        "-p",
        "6789"
      ],
      "cwd": "${workspaceFolder}/out/Linux-clang-debug",
      "terminal": "integrated",
      "stopOnEntry": false,
      "preLaunchTask": "build_debug",
      "osx": {
        "program": "${workspaceFolder}/out/Darwin-clang-debug/bin/observer",
        "cwd": "${workspaceFolder}/out/Darwin-clang-debug"
      },
      "linux": {
        "program": "${workspaceFolder}/out/Linux-clang-debug/bin/observer",
        "cwd": "${workspaceFolder}/out/Linux-clang-debug"
      },
      "windows": {
        "program": "${workspaceFolder}/out/Windows-clang-debug/bin/observer.exe",
        "cwd": "${workspaceFolder}/out/Windows-clang-debug"
      }
    }
  ]
}
