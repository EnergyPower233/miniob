{
  // Cross-platform build tasks for MiniOB.
  //
  // Every task that needs a machine-specific command, argument or environment
  // variable defines a "linux" / "osx" / "windows" override. VS Code merges the
  // matching block on top of the common task before running it, so the same
  // tasks.json works on Windows x86_64, Linux x86_64 and macOS arm64.
  //
  // NOTE: platform blocks support command/args/options/problemMatcher, but NOT
  // dependsOn/group/type, so those stay on the common task definition.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "init",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/build.sh",
        "init"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      // macOS: Homebrew bison/flex are required (the system ones are too old).
      "osx": {
        "command": "/bin/bash",
        "options": {
          "env": {
            "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer",
            "PATH": "/opt/homebrew/opt/bison/bin:/opt/homebrew/opt/flex/bin:/opt/homebrew/bin:${env:PATH}"
          }
        }
      }
    },
    {
      "label": "configure_debug",
      "type": "process",
      "command": "cmake",
      // Common (Linux / Windows) arguments. No generator is forced so an
      // existing build dir keeps its generator and a fresh one uses the
      // platform default (Ninja/Unix Makefiles/MinGW Makefiles).
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build_debug",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DWITH_UNIT_TESTS=ON",
        "-DWITH_BENCHMARK=OFF",
        "-DWITH_MEMTRACER=OFF",
        "-DENABLE_ASAN=ON"
      ],
      "problemMatcher": [],
      // macOS (Apple Silicon): Homebrew bison/flex + tools from Homebrew PATH.
      "osx": {
        "command": "/opt/homebrew/bin/cmake",
        "args": [
          "-S",
          "${workspaceFolder}",
          "-B",
          "${workspaceFolder}/build_debug",
          "-DCMAKE_BUILD_TYPE=Debug",
          "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
          "-DCMAKE_PREFIX_PATH=${workspaceFolder}/deps/3rd/usr/local;/opt/homebrew",
          "-DFLEX_EXECUTABLE=/opt/homebrew/opt/flex/bin/flex",
          "-DBISON_EXECUTABLE=/opt/homebrew/opt/bison/bin/bison",
          "-DWITH_UNIT_TESTS=ON",
          "-DWITH_BENCHMARK=OFF",
          "-DWITH_MEMTRACER=OFF",
          "-DENABLE_ASAN=ON"
        ],
        "options": {
          "env": {
            "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer",
            "PATH": "/opt/homebrew/opt/bison/bin:/opt/homebrew/opt/flex/bin:/opt/homebrew/bin:${env:PATH}"
          }
        }
      },
      // Windows (x86_64): ASan is not portable to MSVC / MinGW here.
      "windows": {
        "args": [
          "-S",
          "${workspaceFolder}",
          "-B",
          "${workspaceFolder}/build_debug",
          "-DCMAKE_BUILD_TYPE=Debug",
          "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
          "-DWITH_UNIT_TESTS=ON",
          "-DWITH_BENCHMARK=OFF",
          "-DWITH_MEMTRACER=OFF",
          "-DENABLE_ASAN=OFF"
        ]
      }
    },
    {
      "label": "build_debug",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build_debug",
        "--parallel",
        "4"
      ],
      "dependsOn": "configure_debug",
      "dependsOrder": "sequence",
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "osx": {
        "command": "/opt/homebrew/bin/cmake",
        "options": {
          "env": {
            "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer",
            "PATH": "/opt/homebrew/bin:${env:PATH}"
          }
        }
      }
    },
    {
      "label": "configure_release",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build_release",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
        "-DWITH_UNIT_TESTS=ON",
        "-DWITH_BENCHMARK=OFF",
        "-DWITH_MEMTRACER=OFF",
        "-DENABLE_ASAN=ON"
      ],
      "problemMatcher": [],
      "osx": {
        "command": "/opt/homebrew/bin/cmake",
        "args": [
          "-S",
          "${workspaceFolder}",
          "-B",
          "${workspaceFolder}/build_release",
          "-DCMAKE_BUILD_TYPE=Release",
          "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
          "-DCMAKE_PREFIX_PATH=${workspaceFolder}/deps/3rd/usr/local;/opt/homebrew",
          "-DFLEX_EXECUTABLE=/opt/homebrew/opt/flex/bin/flex",
          "-DBISON_EXECUTABLE=/opt/homebrew/opt/bison/bin/bison",
          "-DWITH_UNIT_TESTS=ON",
          "-DWITH_BENCHMARK=OFF",
          "-DWITH_MEMTRACER=OFF",
          "-DENABLE_ASAN=ON"
        ],
        "options": {
          "env": {
            "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer",
            "PATH": "/opt/homebrew/opt/bison/bin:/opt/homebrew/opt/flex/bin:/opt/homebrew/bin:${env:PATH}"
          }
        }
      },
      "windows": {
        "args": [
          "-S",
          "${workspaceFolder}",
          "-B",
          "${workspaceFolder}/build_release",
          "-DCMAKE_BUILD_TYPE=Release",
          "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
          "-DWITH_UNIT_TESTS=ON",
          "-DWITH_BENCHMARK=OFF",
          "-DWITH_MEMTRACER=OFF",
          "-DENABLE_ASAN=OFF"
        ]
      }
    },
    {
      "label": "build_release",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build_release",
        "--parallel",
        "4"
      ],
      "dependsOn": "configure_release",
      "dependsOrder": "sequence",
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "osx": {
        "command": "/opt/homebrew/bin/cmake",
        "options": {
          "env": {
            "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer",
            "PATH": "/opt/homebrew/bin:${env:PATH}"
          }
        }
      }
    },
    {
      "label": "test_debug",
      "type": "process",
      "command": "ctest",
      "args": [
        "--test-dir",
        "${workspaceFolder}/build_debug",
        "--output-on-failure"
      ],
      "dependsOn": "build_debug",
      "problemMatcher": [],
      "group": "test",
      "osx": {
        "command": "/opt/homebrew/bin/ctest",
        "options": {
          "env": {
            "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer",
            "PATH": "/opt/homebrew/bin:${env:PATH}"
          }
        }
      }
    },
    {
      "label": "obclient (connect to 127.0.0.1:6789)",
      "type": "process",
      "command": "${workspaceFolder}/build_debug/bin/obclient",
      "args": [
        "-h",
        "127.0.0.1",
        "-p",
        "6789"
      ],
      "options": {
        "cwd": "${workspaceFolder}/build_debug"
      },
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}/build_debug/bin/obclient.exe"
      }
    }
  ]
}
